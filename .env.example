# Local alpha configuration.
# Copy to .env.local and fill only what you need.

# fallback | openai | openai_compatible | local | cli
AI_PROVIDER=fallback

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI-compatible APIs: OpenRouter, custom gateways, LM Studio, Ollama.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Local OpenAI-compatible endpoint example:
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=qwen3:8b
LOCAL_AI_API_KEY=local

# CLI provider. The command receives prompt JSON via stdin and must print JSON/text to stdout.
DND_AI_COMMAND=

AI_TIMEOUT_MS=120000
PORT=8788
